send "python3 @FIXTURES@/socket_action.py report-state idle; python3 @FIXTURES@/socket_action.py create-other; printf '\\033[3J\\033[H\\033[2J'\r"
waitfile @HOME@/parity-popup-owners.json 5s
sleep 1s
clicktext "other"
sleep 500ms
send "python3 @FIXTURES@/socket_action.py report-state working; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
send "python3 @FIXTURES@/socket_action.py report-state idle; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
screen @OUT@/done-active.txt
cells @OUT@/done-active.json
send "echo ACTIVE_INPUT\r"
sleep 500ms
screen @OUT@/after-input.txt
cells @OUT@/after-input.json
click 60 10
sleep 500ms
screen @OUT@/after-click.txt
cells @OUT@/after-click.json
click 5 5
sleep 500ms
screen @OUT@/other.txt
cells @OUT@/other.json
click 5 8
sleep 500ms
screen @OUT@/seen.txt
cells @OUT@/seen.json
resize 60 25
sleep 500ms
screen @OUT@/mobile-seen.txt
cells @OUT@/mobile-seen.json
kill
