resize 60 25
sleep 500ms
screen @OUT@/mobile-unknown.txt
cells @OUT@/mobile-unknown.json
resize 160 45
sleep 500ms
send "python3 @FIXTURES@/socket_action.py report-state working; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
