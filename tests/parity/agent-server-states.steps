send "python3 @FIXTURES@/socket_action.py report-state idle; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
screen @OUT@/desktop-idle.txt
cells @OUT@/desktop-idle.json
resize 60 25
sleep 500ms
screen @OUT@/mobile-idle.txt
cells @OUT@/mobile-idle.json
resize 160 45
sleep 500ms
send "python3 @FIXTURES@/socket_action.py report-state blocked; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
screen @OUT@/desktop-blocked.txt
cells @OUT@/desktop-blocked.json
resize 60 25
sleep 500ms
screen @OUT@/mobile-blocked.txt
cells @OUT@/mobile-blocked.json
resize 160 45
sleep 500ms
