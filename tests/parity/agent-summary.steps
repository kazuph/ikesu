send "python3 @FIXTURES@/socket_action.py report-state working\r"
sleep 250ms
screen @OUT@/desktop-working.txt
cells @OUT@/desktop-working.json
resize 60 25
sleep 250ms
screen @OUT@/mobile-working.txt
cells @OUT@/mobile-working.json
resize 160 45
sleep 250ms
