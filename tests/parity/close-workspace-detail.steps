send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
send "\x02D"
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
resize 100 25
sleep 200ms
screen @OUT@/resize.txt
cells @OUT@/resize.json
send "\x1b"
sleep 200ms
screen @OUT@/cancelled.txt
cells @OUT@/cancelled.json
send "\x1b"
sleep 200ms
resize 160 45
send "\x02c"
sleep 200ms
send "\r"
sleep 200ms
send "\x02v"
sleep 200ms
screen @OUT@/split-normal.txt
cells @OUT@/split-normal.json
send "\x02D"
sleep 200ms
screen @OUT@/multiple.txt
cells @OUT@/multiple.json
send "\x1b"
sleep 200ms
screen @OUT@/multiple-cancelled.txt
cells @OUT@/multiple-cancelled.json
send "\x1b"
sleep 200ms
screen @OUT@/split-returned.txt
cells @OUT@/split-returned.json
kill
