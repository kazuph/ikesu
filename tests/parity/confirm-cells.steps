clicktext "[menu]"
sleep 200ms
screen @OUT@/main-menu.txt
cells @OUT@/main-menu.json
clicktext "stop server"
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
send "z"
sleep 200ms
screen @OUT@/letter.txt
cells @OUT@/letter.json
mouse wheel-down 80 20
sleep 200ms
screen @OUT@/wheel.txt
cells @OUT@/wheel.json
send "\x1b"
sleep 200ms
screen @OUT@/escape.txt
cells @OUT@/escape.json
clicktext "[menu]"
sleep 200ms
clicktext "stop server"
sleep 200ms
resize 100 25
sleep 200ms
screen @OUT@/resize.txt
cells @OUT@/resize.json
click 95 23
sleep 200ms
screen @OUT@/outside.txt
cells @OUT@/outside.json
send "\x1b"
sleep 200ms
kill
