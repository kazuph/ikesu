send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
send "for i in {1..70}; do printf '日本語 alpha.beta \\033[31mRED\\033[0m あいう\\n'; done\r"
sleep 500ms
send "\x02["
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
send "k0"
sleep 200ms
screen @OUT@/up.txt
cells @OUT@/up.json
send "vllllll"
sleep 200ms
screen @OUT@/select.txt
cells @OUT@/select.json
send "\x1b"
sleep 200ms
screen @OUT@/clear.txt
cells @OUT@/clear.json
send "w"
sleep 200ms
screen @OUT@/word.txt
cells @OUT@/word.json
send "W"
sleep 200ms
screen @OUT@/big-word.txt
cells @OUT@/big-word.json
send "/日本語"
sleep 200ms
screen @OUT@/search-entry.txt
cells @OUT@/search-entry.json
send "\r"
sleep 200ms
screen @OUT@/search.txt
cells @OUT@/search.json
send "n"
sleep 200ms
screen @OUT@/next.txt
cells @OUT@/next.json
send "N"
sleep 200ms
screen @OUT@/previous.txt
cells @OUT@/previous.json
send "\x1b"
sleep 200ms
screen @OUT@/clear-search.txt
cells @OUT@/clear-search.json
send "q"
sleep 200ms
screen @OUT@/exit.txt
cells @OUT@/exit.json
kill
