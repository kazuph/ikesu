clicktext "[menu]"
sleep 250ms
screen @OUT@/open.txt
cells @OUT@/open.json
resize 100 25
sleep 250ms
screen @OUT@/small.txt
cells @OUT@/small.json
resize 160 45
sleep 250ms
screen @OUT@/restored.txt
cells @OUT@/restored.json
send "\x1b"
sleep 250ms
send "echo MENU_RESIZE_CLOSED\r"
sleep 250ms
screen @OUT@/closed.txt
cells @OUT@/closed.json
kill
