screen @OUT@/normal.txt
cells @OUT@/normal.json
send "\x02c"
sleep 250ms
screen @OUT@/dialog.txt
cells @OUT@/dialog.json
send "\x1b"
sleep 250ms
screen @OUT@/dialog-closed.txt
cells @OUT@/dialog-closed.json
send "\x02?"
sleep 250ms
screen @OUT@/help.txt
cells @OUT@/help.json
send "\x1b"
sleep 250ms
screen @OUT@/help-closed.txt
cells @OUT@/help-closed.json
send "\x02s"
sleep 250ms
screen @OUT@/settings.txt
cells @OUT@/settings.json
send "\x1b"
sleep 250ms
screen @OUT@/settings-closed.txt
cells @OUT@/settings-closed.json
send "\x02w"
sleep 250ms
screen @OUT@/navigator.txt
cells @OUT@/navigator.json
send "\x1b"
sleep 250ms
screen @OUT@/navigator-closed.txt
cells @OUT@/navigator-closed.json
kill
