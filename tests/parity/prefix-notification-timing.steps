send "python3 @FIXTURES@/socket_action.py report-state idle; python3 @FIXTURES@/socket_action.py create-other; printf '\\033[3J\\033[H\\033[2J'\r"
waitfile @HOME@/parity-popup-owners.json 10s
sleep 1s
send "python3 @FIXTURES@/socket_action.py report-other-state working; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 1s
send "python3 @FIXTURES@/socket_action.py report-other-state idle; printf '\\033[3J\\033[H\\033[2J'\r"
sleep 20ms
screen @OUT@/notification-early.txt
cells @OUT@/notification-early.json
sleep 1s
screen @OUT@/notification.txt
cells @OUT@/notification.json
send "\x02"
sleep 200ms
screen @OUT@/pending.txt
cells @OUT@/pending.json
send "o"
sleep 300ms
screen @OUT@/target.txt
cells @OUT@/target.json
send "printf 'NOTIFICATION_TARGET=%s\\n' \"${HERDR_PANE_ID:-$IKESU_PANE_ID}\"\r"
sleep 250ms
screen @OUT@/input.txt
cells @OUT@/input.json
kill
