send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
send "\x02"
sleep 200ms
screen @OUT@/pending.txt
cells @OUT@/pending.json
send "o"
sleep 300ms
screen @OUT@/result.txt
cells @OUT@/result.json
send "echo PREFIX_NOTIFICATION_INPUT\r"
sleep 250ms
screen @OUT@/input.txt
cells @OUT@/input.json
kill
