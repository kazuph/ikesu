send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
clicktext "[menu]"
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
clicktext "restore agents"
sleep 200ms
screen @OUT@/selected.txt
cells @OUT@/selected.json
send "\x1b"
sleep 200ms
screen @OUT@/cancelled.txt
cells @OUT@/cancelled.json
kill
