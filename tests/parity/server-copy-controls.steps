send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
send "for i in {1..70}; do echo LINE-$i alpha beta gamma; done\r"
sleep 400ms
send "\x02["
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
clicktext "COPY"
sleep 200ms
screen @OUT@/clicked-copy.txt
cells @OUT@/clicked-copy.json
send "g0vly"
sleep 200ms
screen @OUT@/copied.txt
cells @OUT@/copied.json
sleep 2s
screen @OUT@/expired.txt
cells @OUT@/expired.json
kill
