cells @OUT@/reopen-theme.json
send "\x1b[C"
sleep 250ms
send "\x1b[B"
sleep 250ms
screen @OUT@/sound-off-pending.txt
cells @OUT@/sound-off-pending.json
send "\x1b[C"
sleep 250ms
send "\x1b[B"
sleep 250ms
screen @OUT@/toast-next-pending.txt
