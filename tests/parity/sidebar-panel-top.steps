screen @OUT@/before.txt
cells @OUT@/before.json
mouse down 10 24
mouse motion 10 0
mouse up 10 0
sleep 250ms
screen @OUT@/edge.txt
cells @OUT@/edge.json
resize 160 25
sleep 250ms
