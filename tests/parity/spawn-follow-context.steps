send "mkdir -p \"$HOME/alpha\" \"$HOME/beta\" \"$HOME/repo\"; git -C \"$HOME/repo\" init -q; git -C \"$HOME/repo\" -c user.name=Parity -c user.email=parity@example.invalid commit -q --allow-empty -m initial; git -C \"$HOME/repo\" worktree add -q -b feature \"$HOME/feature\"; cd \"$HOME/feature\"\r"
sleep 2s
