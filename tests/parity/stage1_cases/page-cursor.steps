send "python3 @FIXTURES@/key_probe.py @OUT@/received.jsonl 1b5b3f3168 120\r"
waittext 5s PROBE_READY
screen @OUT@/live.txt
cells @OUT@/live.json
send "\u001b[5~"
sleep 100ms
screen @OUT@/up.txt
cells @OUT@/up.json
send "\u001b[5;1:3~"
sleep 100ms
screen @OUT@/release.txt
cells @OUT@/release.json
send "\u001b[6~"
sleep 100ms
screen @OUT@/down.txt
cells @OUT@/down.json
send "\u001b[5;2~"
sleep 100ms
screen @OUT@/shift-up.txt
cells @OUT@/shift-up.json
kill
