send "for i in {1..200}; do printf 'SCROLL_LINE_%03d\\n' $i; done\r"
sleep 500ms
screen @OUT@/before.txt
cells @OUT@/before.json
mouse down 159 12
sleep 200ms
screen @OUT@/track-click.txt
cells @OUT@/track-click.json
mouse motion 159 30
sleep 200ms
screen @OUT@/track-motion.txt
cells @OUT@/track-motion.json
mouse up 159 30
sleep 200ms
screen @OUT@/track-release.txt
cells @OUT@/track-release.json
kill
