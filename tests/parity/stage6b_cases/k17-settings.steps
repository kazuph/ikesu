send "\u0014s"
sleep 200ms
screen @OUT@/open.txt
cells @OUT@/open.json
send "j"
sleep 200ms
screen @OUT@/j.txt
cells @OUT@/j.json
send "k"
sleep 200ms
screen @OUT@/k.txt
cells @OUT@/k.json
send "l"
sleep 200ms
screen @OUT@/l.txt
cells @OUT@/l.json
send "\u001b[B"
sleep 200ms
screen @OUT@/down.txt
cells @OUT@/down.json
send " "
sleep 200ms
screen @OUT@/space.txt
cells @OUT@/space.json
send "\r"
sleep 200ms
screen @OUT@/enter.txt
cells @OUT@/enter.json
send "h"
sleep 200ms
screen @OUT@/h.txt
cells @OUT@/h.json
send "\u001b"
sleep 200ms
send "\u0014s"
sleep 200ms
screen @OUT@/reopen.txt
cells @OUT@/reopen.json
kill
