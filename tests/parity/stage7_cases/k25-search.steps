send "printf '\\033[3J\\033[H\\033[2J'; for i in {1..120}; do printf 'ROW-%03d alpha ALPHA Beta abcdefghijklmnopqrstuvwxyz\\n' $i; done; sleep 120\r"
sleep 200ms
sleep 400ms
send "\u0014["
sleep 200ms
send "/alpha\r"
sleep 200ms
screen @OUT@/lower.txt
cells @OUT@/lower.json
send "/Alpha\r"
sleep 200ms
screen @OUT@/upper.txt
cells @OUT@/upper.json
send "/alpha\r"
sleep 200ms
screen @OUT@/committed.txt
cells @OUT@/committed.json
send "/Beta"
sleep 200ms
send "\u001b"
sleep 200ms
screen @OUT@/cancelled.txt
cells @OUT@/cancelled.json
send "/\r"
sleep 200ms
screen @OUT@/empty.txt
cells @OUT@/empty.json
send "/Beta\u0015"
sleep 200ms
screen @OUT@/cleared.txt
cells @OUT@/cleared.json
send "\u001b"
sleep 200ms
send "n"
sleep 200ms
screen @OUT@/repeated.txt
cells @OUT@/repeated.json
kill
