send "printf '\\033[3J\\033[H\\033[2J'; for i in {1..120}; do printf 'ROW-%03d alpha ALPHA Beta abcdefghijklmnopqrstuvwxyz\\n' $i; done; sleep 120\r"
sleep 200ms
sleep 400ms
mouse down 80 3
sleep 800ms
screen @OUT@/click-edge.txt
cells @OUT@/click-edge.json
mouse up 80 3
mouse down 80 20
mouse motion 80 3
sleep 800ms
screen @OUT@/drag-edge.txt
cells @OUT@/drag-edge.json
mouse motion 80 2
sleep 200ms
screen @OUT@/drag-outside.txt
cells @OUT@/drag-outside.json
mouse up 80 2
kill
