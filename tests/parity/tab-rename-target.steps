send "printf '\\033[3J\\033[H\\033[2J'\r"
sleep 250ms
send "\x02c"
sleep 200ms
send "\r"
sleep 200ms
screen @OUT@/before.txt
cells @OUT@/before.json
rclick 28 1
sleep 200ms
screen @OUT@/menu.txt
cells @OUT@/menu.json
clicktext "Rename"
sleep 200ms
screen @OUT@/rename.txt
cells @OUT@/rename.json
send "\r"
sleep 200ms
screen @OUT@/saved.txt
cells @OUT@/saved.json
rclick 28 1
sleep 200ms
clicktext "Rename"
sleep 200ms
screen @OUT@/reopened.txt
cells @OUT@/reopened.json
send "\x1b"
sleep 200ms
screen @OUT@/cancelled.txt
cells @OUT@/cancelled.json
kill
