screen @OUT@/boot.txt
cells @OUT@/boot.json
send "\x02T"
sleep 250ms
send "\x03LONG TAB NAME\r"
sleep 250ms
screen @OUT@/named.txt
cells @OUT@/named.json
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
sleep 250ms
send "\x02c"
sleep 250ms
send "\r"
