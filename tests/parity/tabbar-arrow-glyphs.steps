screen @OUT@/eight-tabs.txt
cells @OUT@/eight-tabs.json
resize 80 25
sleep 250ms
screen @OUT@/overflow.txt
cells @OUT@/overflow.json
click 28 1
sleep 250ms
screen @OUT@/arrow-left.txt
cells @OUT@/arrow-left.json
click 28 1
sleep 250ms
screen @OUT@/arrow-left-again.txt
cells @OUT@/arrow-left-again.json
click 75 1
sleep 250ms
screen @OUT@/arrow-right.txt
cells @OUT@/arrow-right.json
send "\x021"
sleep 250ms
screen @OUT@/select-first.txt
cells @OUT@/select-first.json
click 28 1
sleep 250ms
screen @OUT@/disabled-left.txt
cells @OUT@/disabled-left.json
click 75 1
sleep 250ms
screen @OUT@/first-arrow-right.txt
cells @OUT@/first-arrow-right.json
click 75 1
sleep 250ms
screen @OUT@/first-arrow-right-again.txt
cells @OUT@/first-arrow-right-again.json
click 28 1
sleep 250ms
screen @OUT@/right-then-left.txt
cells @OUT@/right-then-left.json
